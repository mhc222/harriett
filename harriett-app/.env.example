# Supabase (new Phase 2 project, not the demo project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Places API (New), server-side address autocomplete and resolution.
GOOGLE_MAPS_API_KEY=

# Per-agent Google OAuth for personal Gmail and Calendar accounts.
# Create a Web application OAuth client with this exact production callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://harriett-app.vercel.app/api/integrations/google/callback
# 32 random bytes encoded as base64 or 64 hexadecimal characters.
CONNECTION_ENCRYPTION_KEY=
# Required to activate Gmail push monitoring after OAuth is connected.
GOOGLE_GMAIL_PUBSUB_TOPIC=
GOOGLE_GMAIL_MONITORED_TO=
# Audience configured on the authenticated Pub/Sub push subscription. Use the
# Gmail webhook URL unless you intentionally choose a separate audience.
GOOGLE_PUBSUB_AUDIENCE=https://harriett-app.vercel.app/api/webhooks/google/gmail
# User-managed service account selected for authenticated Pub/Sub push.
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # fallback provider, optional but wired
FIRECRAWL_API_KEY=         # controlled AREC legal-corpus extraction

# Personal memory. Shadow mode records proposed memories but never activates them.
MEMORY_MODE=shadow
MEM0_TELEMETRY=false
MEM0_LLM_MODEL=gpt-5-mini

# Public property search, valuation and preliminary comps
# Optional emergency brake. Leave true in live builds where RentCast is available.
RENTCAST_ENABLED=true
RENTCAST_API_KEY=

# Closed-beta portal observations for CMA candidate enrichment.
# Data is always labeled as portal-observed and MLS-unverified.
BRIGHT_DATA_ENABLED=false
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZILLOW_DATASET_ID=gd_lfqkr8wm13ixtbd8f5

# Trigger.dev v4
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# SMS delivery modes: disabled, dry_run, or live.
# dry_run lets inbound SMS, Trigger, and AI run while saving the reply instead of sending it.
SMS_DELIVERY_MODE=disabled

# Twilio SMS. Keep live sending disabled until the sender and compliance setup are ready.
TWILIO_SEND_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_URL=          # public URL of /api/webhooks/twilio, used for signature validation
TWILIO_STATUS_CALLBACK_URL=  # public URL of /api/webhooks/twilio/status

# Twilio WhatsApp sandbox. Agent-only testing while SMS/RCS setup is pending.
# Sandbox sender is usually whatsapp:+14155238886.
WHATSAPP_DELIVERY_MODE=dry_run
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=
